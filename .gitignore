# ==============================================================================
# LumiNest Real Estate — Git Ignore Rules (Security & Lightweight Repository)
# ==============================================================================

# 1. Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 2. Next.js & Turbopack Build Outputs
/.next/
/out/
/build
/dist
/.turbo/

# 3. TypeScript & Testing Caches
*.tsbuildinfo
next-env.d.ts
/coverage

# 4. Environment Variables & Secret Credentials (CRITICAL SECURITY)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
id_rsa
id_ed25519
credentials.json
token.json
service-account*.json

# 5. Python Artifacts & Caches (Skills Scripts)
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.venv/
venv/
env/

# 6. Logs & Debug Dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# 7. OS Metadata & Temporary Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 8. IDE & Editor Files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.tmp

# 9. Vercel & Deployment
.vercel

# 10. Local Agent / Runtime Temporary Artifacts (if created locally)
.gemini/

